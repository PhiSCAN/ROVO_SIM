<?xml version="1.0" ?>
<!--
  Autoware sample environment — CloudCompare point cloud scan.

  OBJ survey coordinates: x≈3745, y≈73713, z∈[17.4, 35.8].
  Pose offset centers mesh at world origin:
    x: -3744.9643  (centroid)
    y: -73713.4409 (centroid)
    z: -17.40      (collision z_min)

  Collision: autoware_collision.stl — real terrain mesh (250k tris).
             Robot drives ON the actual scanned surface, follows all
             slopes/curbs. Static mesh → gz-sim builds BVH once, cheap.
  Visual:    autoware_visual.glb — full 2M-face GLB.

  Both share the same pose offset so visual and collision align exactly.

  Spawn: world (-10, 30, 3.0) — drops onto real road surface (z≈1.86).
-->
<sdf version="1.10">
  <world name="autoware">

    <scene>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.4 0.6 0.8 1</background>
    </scene>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>37.7749</latitude_deg>
      <longitude_deg>-122.4194</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!--
      Autoware environment — single model, real mesh collision + visual.
      Collision STL (250k tris) follows actual terrain; robot drives on it.
      Visual GLB (2M tris) for appearance. Same link → guaranteed aligned.
    -->
    <model name="autoware_environment">
      <static>true</static>
      <pose>-3744.9643 -73713.4409 -17.40 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>rovo_worlds/meshes/autoware_collision.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>rovo_worlds/meshes/autoware_visual.glb</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
