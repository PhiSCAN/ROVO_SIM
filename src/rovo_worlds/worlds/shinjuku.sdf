<?xml version="1.0" ?>
<!--
  AWSIM Shinjuku environment — converted from Shinjuku.unitypackage.

  Source: 16 FBX chunks (SJK01_P01..P06 map + trees + traffic lights),
          imported in Blender 3.3, exported as one aligned scene:
            shinjuku_visual.glb     — textured (PNG embedded, 512px max, 190M
                                       vs 678M full). PNG not JPEG: gz ogre2
                                       decodes embedded PNG reliably, embedded
                                       JPEG renders flat. kill_metallic.py
                                       zeroes metallic (64 facade mats were
                                       metallic=1) AND emissive (265 mats had
                                       emissiveFactor=[1,1,1] white glow ->
                                       solid-white buildings). Z-up (export
                                       _yup=False) so it aligns with the STL
            shinjuku_collision.stl  — decimated 0.1 -> 326k tris (full 2.4M
                                       collision BVH froze a 15 GB machine)

  Blender world-space bbox (metres, 1:1):
    min (-672.52, -568.47, -23.21)  max (538.64, 692.40, 236.77)
    Raycast: dominant flat (road) surface at mesh z ~= -2. z_min=-23.2 is
    stray underground geometry, NOT the ground — do not zero to it.

  Pose offset puts a REAL asphalt road cell at world origin (the map centre
  is a raised plaza, not road). Road located by road-material faces in the
  FBX (road_spawn.py), then the DECIMATED collision (gz uses that) was
  raycast at that XY (road_collide.py): contact mesh(-50.28, -9.45, -7.46),
  normal.z=1.0 (flat road). Offset = -contact places it at world (0,0,0):
    x: 50.28   y: 9.45   z: 7.46

  Visual + collision share this pose => exact alignment (both Z-up, one scene).

  Spawn: world (0, 0, 0.5) — small drop onto the central road cell.
-->
<sdf version="1.10">
  <world name="shinjuku">

    <scene>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.4 0.6 0.8 1</background>
    </scene>

    <physics name="3ms" type="ignored">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>35.6895</latitude_deg>
      <longitude_deg>139.6917</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- Toned down vs autoware: light beige facades + bright sun/specular
         clamped to white ("Color values were clamped"). Lower diffuse, no
         specular so albedo textures read instead of blowing out. -->
    <!-- Shadows OFF: one directional shadow map stretched over a 1.2 km
         world gives huge texels -> acne/blocky shadow projecting onto the
         robot. Flat ambient+diffuse reads cleaner here. -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!--
      Shinjuku environment — single static link, full mesh collision + tiled
      visual. Collision STL = everything (all 1776 mesh objects) in one mesh.
      Static => gz-sim builds BVH once. Visual = 78 tile GLBs (100 m grid),
      each its own <visual>/cull unit. Same link/pose => guaranteed aligned.
    -->
    <model name="shinjuku_environment">
      <static>true</static>
      <pose>50.28 9.45 7.46 0 0 0</pose>
      <link name="link">
        <!-- Collapse-decimating "everything" lifted the collision ~0.46 m
             above the visual road (road verts pulled toward curbs/walls),
             so the robot stood on air over the visible road. This local
             pose drops collision 0.46 m to align with the visual surface on
             open road. (Near building bases the lift is larger, but the
             robot drives roads.) -->
        <collision name="collision">
          <pose>0 0 -0.46 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>rovo_worlds/meshes/shinjuku_collision.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
          </surface>
        </collision>
        <!-- City split into 100 m tiles (tile_split.py). One <visual> per
             tile = one ogre2 cull unit each (warehouse-style), instead of a
             single 1 km off-centre monolith which gz drops at close range.
             All share the link pose so they stay aligned with the collision. -->
        <visual name="tile_0_0">
          <geometry><mesh>
            <uri>rovo_worlds/meshes/shinjuku_tiles/tile_0_0.glb</uri>
          </mesh></geometry>
        </visual>
        <visual name="tile_0_6">
          <geometry><mesh>
            <uri>rovo_worlds/meshes/shinjuku_tiles/tile_0_6.glb</uri>
          </mesh></geometry>
        </visual>
        <visual name="tile_0_7">
          <geometry><mesh>
            <uri>rovo_worlds/meshes/shinjuku_tiles/tile_0_7.glb</uri>
          </mesh></geometry>
        </visual>
        <visual name="tile_0_8">
          <geometry><mesh>
            <uri>rovo_worlds/meshes/shinjuku_tiles/tile_0_8.glb</uri>
          </mesh></geometry>
        </visual>
        <visual name="tile_0_9">
          <geometry><mesh>
            <uri>rovo_worlds/meshes/shinjuku_tiles/tile_0_9.glb</uri>
          </mesh></geometry>
        </visual>
        <visual name="tile_1_0">
          <geometry><mesh>
            <uri>rovo_worlds/meshes/shinjuku_tiles/tile_1_0.glb</uri>
          </mesh></geometry>
        </visual>
        <visual name="tile_1_1">
          <geometry><mesh>
