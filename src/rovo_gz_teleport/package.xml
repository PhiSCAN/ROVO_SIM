<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rovo_gz_teleport</name>
  <version>0.1.0</version>
  <description>Gazebo GUI panel that teleports rovo to a clicked or typed pose.</description>
  <maintainer email="tombabyrose@gmail.com">phicode-robotics</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>gz_gui_vendor</depend>
  <depend>gz_msgs_vendor</depend>
  <depend>gz_plugin_vendor</depend>
  <depend>gz_transport_vendor</depend>
  <depend>gz_sim_vendor</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
