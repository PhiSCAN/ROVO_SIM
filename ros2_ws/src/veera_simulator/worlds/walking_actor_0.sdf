<?xml version='1.0' encoding='ASCII'?>
<!-- Animated walking actor for the warehouse world.
     Central-open-area loop. Spawned by rovo_clearpath.launch.py when actors:=true.
     Ref: https://gazebosim.org/docs/latest/actors/ -->
<sdf version='1.7'>
  <actor name='actor_walker_0'>
    <skin>
      <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
      <scale>1.0</scale>
    </skin>
    <animation name='walk'>
      <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
      <scale>1.0</scale>
      <interpolate_x>true</interpolate_x>
    </animation>
    <script>
      <loop>true</loop>
      <delay_start>0.0</delay_start>
      <auto_start>true</auto_start>
      <trajectory id='0' type='walk'>
        <waypoint><time>0.0</time><pose>-6 2 1.0 0 0 1.57</pose></waypoint>
        <waypoint><time>5.0</time><pose>-6 7 1.0 0 0 1.57</pose></waypoint>
        <waypoint><time>6.0</time><pose>-6 7 1.0 0 0 0</pose></waypoint>
        <waypoint><time>17.0</time><pose>5 7 1.0 0 0 0</pose></waypoint>
        <waypoint><time>18.0</time><pose>5 7 1.0 0 0 -1.57</pose></waypoint>
        <waypoint><time>23.0</time><pose>5 2 1.0 0 0 -1.57</pose></waypoint>
        <waypoint><time>24.0</time><pose>5 2 1.0 0 0 3.14</pose></waypoint>
        <waypoint><time>35.0</time><pose>-6 2 1.0 0 0 3.14</pose></waypoint>
        <waypoint><time>36.0</time><pose>-6 2 1.0 0 0 1.57</pose></waypoint>
      </trajectory>
    </script>
  </actor>
</sdf>
