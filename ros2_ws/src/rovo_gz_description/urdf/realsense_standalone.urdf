<?xml version="1.0"?>
<robot name="realsense_standalone">

  <link name="world"/>

  <link name="base_link"/>

  <joint name="world_base_joint" type="fixed">
    <parent link="world"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="realsense_link">
    <inertial>
      <mass value="0.072"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="realsense_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="realsense_link"/>
    <origin xyz="0 0 1.0" rpy="0 -0.1745 0"/>
  </joint>

  <gazebo reference="realsense_link">
    <sensor name="realsense_sensor" type="rgbd_camera">
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <topic>camera/camera</topic>
      <gz_frame_id>realsense_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.5184</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>RGB_INT8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
        <depth_camera>
          <clip><near>0.105</near><far>10.0</far></clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>

</robot>
