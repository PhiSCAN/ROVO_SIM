<?xml version="1.0"?>
<robot name="rovo" xmlns:xacro="http://www.ros.org/wiki/xacro">


  <!-- ============================================================ -->
  <!-- Properties                                                   -->
  <!-- ============================================================ -->
  <xacro:property name="pkg"             value="rovo_gz_description"/>

  <xacro:property name="base_mass"       value="50.0"/>
  <xacro:property name="base_x"          value="1.464"/>  <!-- length (X = forward) -->
  <xacro:property name="base_y"          value="1.312"/>  <!-- width  (Y = left)    -->
  <xacro:property name="base_z"          value="0.728"/>  <!-- height above wheel top -->
  <xacro:property name="base_cz"         value="0.544"/>  <!-- collision center z -->

  <xacro:property name="wheel_mass"      value="5.0"/>
  <xacro:property name="wheel_radius"    value="0.09"/>
  <xacro:property name="wheel_length"    value="0.18"/>   <!-- wider for terrain grip -->
  <xacro:property name="wheel_x"         value="0.547"/>  <!-- half-separation -->
  <xacro:property name="wheel_z"         value="0.09"/>   <!-- ground clearance offset -->

  <!-- ============================================================ -->
  <!-- Macros                                                       -->
  <!-- ============================================================ -->
  <xacro:macro name="box_inertia" params="m x y z cx:=0 cy:=0 cz:=0">
    <inertial>
      <origin xyz="${cx} ${cy} ${cz}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(y*y+z*z)/12.0}" ixy="0" ixz="0"
        iyy="${m*(x*x+z*z)/12.0}" iyz="0"
        izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cyl_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(3.0*r*r+h*h)/12.0}" ixy="0" ixz="0"
        iyy="${m*(3.0*r*r+h*h)/12.0}" iyz="0"
        izz="${0.5*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="visual_mesh" params="name">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://${pkg}/meshes/visual/${name}.dae"/>
      </geometry>
    </visual>
  </xacro:macro>

  <xacro:macro name="drive_wheel" params="side reflect">
    <link name="${side}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
        <material name="invisible">
          <color rgba="0 0 0 0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
      </collision>
      <xacro:cyl_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_length}"/>
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${side}_wheel"/>
      <origin xyz="0 ${-reflect*wheel_x} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="10.0" friction="0.5"/>
    </joint>

    <gazebo reference="${side}_wheel">
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
      <!-- kp/kd tuned for clearpath worlds' max_step_size=0.003 s.
           Stability requires dt < 1/sqrt(kp/m). With m=5kg + dt=3ms,
           kp must stay ≤ ~5e5. Higher kp triggers solver-eject teleport. -->
      <kp>5e5</kp>
      <kd>50.0</kd>
      <minDepth>0.003</minDepth>
      <maxVel>1.0</maxVel>
    </gazebo>
  </xacro:macro>

  <!-- ============================================================ -->
  <!-- base_footprint (ground projection)                           -->
  <!-- ============================================================ -->
  <link name="base_footprint"/>

  <joint name="base_footprint_to_base" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- base_link: all 21 GLB meshes as visuals + box collision      -->
  <!-- Mesh vertex data is baked at world coords (Z origin=0),     -->
  <!-- so visual origin is offset by -0.46 to undo base_link lift.  -->
  <!-- ============================================================ -->
  <link name="base_link">

    <!-- 21 visuals — mesh vertex data already in world coords (Z 0.012..0.908) -->
    <xacro:macro name="vis" params="name">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${pi/2}"/>
        <geometry>
          <mesh filename="package://${pkg}/meshes/visual/${name}.dae"/>
        </geometry>
      </visual>
    </xacro:macro>

    <xacro:macro name="vis_black" params="name">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${pi/2}"/>
        <geometry>
          <mesh filename="package://${pkg}/meshes/visual/${name}.dae"/>
        </geometry>
        <material name="track_black">
          <color rgba="0.05 0.05 0.05 1.0"/>
        </material>
      </visual>
    </xacro:macro>

    <xacro:vis name="body"/>
    <xacro:vis name="camera_holder"/>
    <xacro:vis name="lightbody"/>
    <xacro:vis name="pipes"/>
    <xacro:vis name="wheel_holder"/>
    <xacro:vis_black name="wheelTrack_new"/>
    <xacro:vis_black name="wheelTrack_new_001"/>
    <xacro:vis name="wl"/>
    <xacro:vis name="wl1"/>
    <xacro:vis name="wl2"/>
    <xacro:vis name="wl3"/>
    <xacro:vis name="wl4"/>
    <xacro:vis name="wl5"/>
    <xacro:vis name="wl6"/>
    <xacro:vis name="wr"/>
    <xacro:vis name="wr1"/>
    <xacro:vis name="wr2"/>
    <xacro:vis name="wr3"/>
    <xacro:vis name="wr4"/>
    <xacro:vis name="wr5"/>
    <xacro:vis name="wr6"/>

    <!-- Chassis collision box -->
    <collision name="chassis_box">
      <origin xyz="0.013 0 0.544" rpy="0 0 0"/>
      <geometry>
        <box size="${base_x} ${base_y} ${base_z}"/>
      </geometry>
    </collision>

    <!-- Skid plates removed: wider wheels (0.18m) overlapped skid Y range,
         causing solver-eject teleport back to spawn. Wider wheel contact
         patch alone provides enough pitch stability for diff-drive. -->

    <!-- Skid bars removed: caused teleport-to-spawn in office (solver-eject
         on multi-contact stiffness). Use small forward CoM bias instead. -->

    <!-- 5 mm forward CoM bias → mild predictable forward lean, no jitter.
         Robot rests on wheels with slight forward pitch (~0.5°), stable. -->
    <xacro:box_inertia m="${base_mass}" x="${base_x}" y="${base_y}" z="${base_z}"
                       cx="0.005" cy="0" cz="0.40"/>
  </link>

  <gazebo reference="base_link">
    <mu1>0.05</mu1>
    <mu2>0.05</mu2>
    <kp>5e5</kp>
    <kd>50.0</kd>
    <minDepth>0.003</minDepth>
  </gazebo>

  <!-- ============================================================ -->
  <!-- Drive wheels (invisible)                                     -->
  <!-- ============================================================ -->
  <xacro:drive_wheel side="left"  reflect="-1"/>
  <xacro:drive_wheel side="right" reflect="1"/>

  <!-- ============================================================ -->
  <!-- IMU link                                                     -->
  <!-- ============================================================ -->
  <link name="phiimu_frame2">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="phiimu_frame2"/>
    <origin xyz="0.548019 -0.02886 0.829417" rpy="-0.004375 -0.060599 1.610255"/>
  </joint>

  <!-- ============================================================ -->
  <!-- Velodyne 3D LiDAR                                            -->
  <!-- ============================================================ -->
  <link name="velodyne">
    <inertial>
      <mass value="0.83"/>
      <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0516" length="0.0717"/>
      </geometry>
    </visual>
    <!-- No collision — sensor must not block physics. -->
  </link>

  <joint name="velodyne_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="velodyne"/>
    <origin xyz="0.475 0 1.05" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- GPS (single antenna, on top of Velodyne + 2.5 cm)           -->
  <!-- ============================================================ -->
  <link name="gps_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
    </visual>
  </link>

  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="gps_link"/>
    <origin xyz="0.475 0 1.11" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- RealSense Depth Camera                                       -->
  <!-- ============================================================ -->
  <link name="realsense_link">
    <inertial>
      <mass value="0.072"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="realsense_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="realsense_link"/>
    <origin xyz="0.55 0 1.25" rpy="0 -0.1745 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- Gazebo Sim (Harmonic/Ionic) system plugins                   -->
  <!-- ============================================================ -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${2*wheel_x}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_velocity>1.0</max_angular_velocity>
      <topic>cmd_vel_gcs</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic></tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>

    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
  </gazebo>

  <gazebo reference="phiimu_frame2">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <topic>imu/data2</topic>
      <gz_frame_id>phiimu_frame2</gz_frame_id>
    </sensor>
  </gazebo>

  <gazebo reference="velodyne">
    <sensor name="velodyne_sensor" type="gpu_lidar">
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <topic>/velodyne_points</topic>
      <gz_frame_id>velodyne</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>1875</samples>
            <resolution>1</resolution>
            <min_angle>-${pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-${15.0*pi/180.0}</min_angle>
            <max_angle>${15.0*pi/180.0}</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>100.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="realsense_link">
    <sensor name="realsense_sensor" type="rgbd_camera">
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <topic>camera/camera</topic>
      <gz_frame_id>realsense_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.5184</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>RGB_INT8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
        <depth_camera>
          <clip><near>0.105</near><far>10.0</far></clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>

</robot>
