Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: realsense_link
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/Image
      Name: Color Image
      Enabled: true
      Topic:
        Value: /camera/camera/color/image_raw
        Depth: 5
        Reliability Policy: Reliable
        History Policy: Keep Last
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: Depth Image
      Enabled: true
      Topic:
        Value: /camera/camera/depth/image_rect_raw_uint16
        Depth: 5
        Reliability Policy: Reliable
        History Policy: Keep Last
      Normalize Range: true
      Min Value: 0.0
      Max Value: 10.0
    - Class: rviz_default_plugins/PointCloud2
      Name: Pointcloud
      Enabled: true
      Topic:
        Value: /camera/camera/depth/color/points
        Depth: 5
        Reliability Policy: Reliable
        History Policy: Keep Last
      Style: Points
      Size (m): 0.01
      Color Transformer: RGB8
      Alpha: 1.0
  Global Options:
    Fixed Frame: realsense_link
    Frame Rate: 30
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.5
      Pitch: 0.3
      Yaw: 0.785
      Target Frame: realsense_link
